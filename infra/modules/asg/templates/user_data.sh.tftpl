#!/bin/bash
set -euxo pipefail

dnf update -y
dnf install -y httpd php php-mysqlnd php-cli php-xml php-mbstring jq unzip mariadb105

# Pull DB connection details from Secrets Manager (assignment-db-credentials)
# using this instance's IAM role - no credentials are ever hardcoded here.
SECRET_JSON=$(aws secretsmanager get-secret-value \
  --secret-id "${secret_arn}" \
  --region "${aws_region}" \
  --query SecretString --output text)

DB_HOST=$(echo "$SECRET_JSON" | jq -r .host)
DB_USER=$(echo "$SECRET_JSON" | jq -r .username)
DB_PASS=$(echo "$SECRET_JSON" | jq -r .password)
DB_NAME=$(echo "$SECRET_JSON" | jq -r .dbname)

# IMPORTANT: do NOT create a second file with its own "[www]" section here.
# php-fpm's default package config already defines a pool named "www" in
# /etc/php-fpm.d/www.conf. Two files both declaring "[www]" is a fatal
# config error - php-fpm refuses to start, Apache is left with nothing on
# the other end of the fastcgi socket, and every PHP request then fails at
# the ALB as a 502 Bad Gateway (the target accepts the TCP connection but
# never returns a valid response). Appending plain "env[...]" lines to the
# END of the existing www.conf adds them to that same pool instead of
# declaring a duplicate one.
cat <<EOF >> /etc/php-fpm.d/www.conf
env[DB_HOST] = $DB_HOST
env[DB_USER] = $DB_USER
env[DB_PASS] = $DB_PASS
env[DB_NAME] = $DB_NAME
env[AWS_S3_BUCKET] = ${artifact_bucket}
env[AWS_S3_REGION] = ${aws_region}
EOF

mkdir -p /var/www/html

cat <<EOF > /var/www/html/.env
DB_HOST=$DB_HOST
DB_USER=$DB_USER
DB_PASS=$DB_PASS
DB_NAME=$DB_NAME
AWS_S3_BUCKET=${artifact_bucket}
AWS_S3_REGION=${aws_region}
EOF

# Self-healing deploy: every new/replaced instance (scale-out, instance
# refresh, terraform apply after a destroy, etc.) pulls whatever was last
# shipped by the deploy.yml workflow, so the fleet never drifts back to the
# placeholder page after the first real deploy. Falls back to a placeholder
# only before any deploy has ever run.
if aws s3api head-object --bucket "${artifact_bucket}" --key "${artifact_key}" --region "${aws_region}" > /dev/null 2>&1; then
  aws s3 cp "s3://${artifact_bucket}/${artifact_key}" /tmp/assignment-app.zip --region "${aws_region}"
  rm -rf /var/www/html/*
  unzip -o /tmp/assignment-app.zip -d /var/www/html
  # Recreate .env after unzip (unzip wipes the dir first)
  cat <<ENVEOF > /var/www/html/.env
DB_HOST=$DB_HOST
DB_USER=$DB_USER
DB_PASS=$DB_PASS
DB_NAME=$DB_NAME
AWS_S3_BUCKET=${artifact_bucket}
AWS_S3_REGION=${aws_region}
ENVEOF
  chown -R apache:apache /var/www/html
else
  echo "<?php http_response_code(200); echo 'assignment-sport-facility-bookings: bootstrapped, waiting for first deploy.';" \
    > /var/www/html/index.php
  # Matches healthz.php's contract (no DB dependency) so the ALB target group
  # already sees this instance as healthy before the first real deploy.
  echo "<?php http_response_code(200); header('Content-Type: text/plain'); echo 'ok';" \
    > /var/www/html/healthz.php
fi

systemctl enable php-fpm || true
systemctl restart php-fpm || true
systemctl enable httpd
systemctl restart httpd
